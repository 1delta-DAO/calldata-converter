{
  "name": "converter",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "forge install && tsx ./src/cli.ts --run-tests",
    "test": "forge install && vitest run --passWithNoTests",
    "build": "forge install && esbuild ./src/cli.ts --bundle --packages=external --platform=node --target=node22 --format=esm --outfile=dist/cli.js",
    "prepare-package": "forge install && tsx src/preparePackage.ts",
    "build:pack": "forge install && pnpm run start && pnpm run prepare-package && pnpm prettier . --write"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "glob": "^13.0.6",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "viem": "^2.48.4",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@1delta/calldatalib": "workspace:*",
    "@1delta/sol-to-ts": "workspace:*",
    "axios": "^1.15.2"
  }
}
