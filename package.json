{
  "name": "converter",
  "type": "module",
  "scripts": {
    "start": "forge install && tsx ./src/cli.ts --run-tests",
    "test": "forge install && vitest run --passWithNoTests",
    "build": "forge install && esbuild ./src/cli.ts --bundle --packages=external --platform=node --target=node22 --format=esm --outfile=dist/cli.js",
    "prepare-package": "forge install && tsx src/preparePackage.ts",
    "pack": "forge install && pnpm run start && pnpm run prepare-package"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "esbuild": "^0.25.11",
    "glob": "^11.0.3",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4",
    "viem": "^2.24.1"
  },
  "peerDependencies": {
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "axios": "^1.8.4"
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39"
}
