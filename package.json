{
  "name": "converter",
  "type": "module",
  "scripts": {
    "start": "forge install && bun run ./src/cli.ts --run-tests",
    "test": "forge install && bun test",
    "build": "forge install && bun build --target node --production ./src/cli.ts --outdir ./dist",
    "prepare-package": "forge install && bun run src/preparePackage.ts",
    "pack": "forge install && bun run start && bun run prepare-package"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.13.14",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "viem": "^2.24.1"
  },
  "peerDependencies": {
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "axios": "^1.8.4"
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39"
