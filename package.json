{
  "name": "converter",
  "type": "module",
  "scripts": {
    "start": "forge install && tsx ./src/cli.ts --run-tests",
    "test": "forge install && vitest run --passWithNoTests",
    "build": "forge install && esbuild ./src/cli.ts --bundle --packages=external --platform=node --target=node22 --format=esm --outfile=dist/cli.js",
    "prepare-package": "forge install && tsx src/preparePackage.ts",
    "pack": "forge install && pnpm run start && pnpm run prepare-package"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "glob": "^13.0.6",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "viem": "^2.48.2",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "axios": "^1.15.1"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
