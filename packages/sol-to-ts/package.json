  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@solidity-parser/parser": "^0.20.1",
    "prettier": "^3.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
