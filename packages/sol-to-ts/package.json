{
  "name": "@1delta/sol-to-ts",
  "version": "0.1.0",
  "description": "AST-based Solidity to TypeScript converter with pluggable emitters and optional forge+vitest validation",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./validate": "./src/validate/index.ts",
